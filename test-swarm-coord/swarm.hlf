-- HLF Swarm Coordination Program
-- Task: Build Node.js TaskQueue + Worker module
-- 3 agents, explicit interfaces, no chat coordination
--
-- Persona-first agent definitions:
--   Steward: Oversight & governance
--   Herald: Communication & coordination
--   Builder: Construction & implementation
--   Sentinel: Security & verification

program TaskQueueModule {
  metadata {
    name: "task-queue-module"
    version: "1.0.0"
    agents: 4
    gas_total: 4500
    personas: ["Steward", "Herald", "Builder", "Sentinel"]
  }

  -- Persona definitions (persona-first architecture)
  persona Steward {
    description: "Overseer of swarm governance and resource allocation"
    capabilities: [oversight, governance, resource_allocation, checkpoint_management]
    trust_tier: "forge"
    default_constraints: ["maintain quorum", "enforce gas limits", "audit all phases"]
    communication_style: "authoritative"
    supervision: ["Builder", "Herald"]
  }

  persona Herald {
    description: "Communication bridge between agents and external systems"
    capabilities: [routing, messaging, event_broadcast, state_sync]
    trust_tier: "hearth"
    default_constraints: ["guarantee delivery", "preserve message ordering"]
    communication_style: "diplomatic"
    supervision: ["Sentinel"]
  }

  persona Builder {
    description: "Primary construction and implementation agent"
    capabilities: [implementation, file_write, code_generation, testing]
    trust_tier: "hearth"
    default_constraints: ["follow interface contracts", "emit checksum proofs"]
    communication_style: "precise"
    supervision: []
  }

  persona Sentinel {
    description: "Security auditing and verification agent"
    capabilities: [verification, security_audit, formal_proof, constraint_checking]
    trust_tier: "forge"
    default_constraints: ["block on counterexample", "log all violations"]
    communication_style: "assertive"
    supervision: ["Builder", "Herald"]
  }

  -- Interface contracts (SSOT for coordination)
  interface TaskQueue {
    methods: [enqueue, dequeue, peek, size]
    enqueue(task: { id: string, data: any, priority: number }): void
    dequeue(): Task | undefined
    peek(): Task | undefined
    size(): number
    invariant: "higher priority dequeued first; FIFO tie-break"
  }

  interface Worker {
    constructor(queue: TaskQueue, options: { concurrency: number, retryCount: number })
    methods: [start, stop, on]
    start(): void
    stop(): Promise<void>
    on(event: EventName, handler: Function): void
    events: [task_start, task_complete, task_error, started, stopped]
    invariant: "concurrency limit enforced; retries up to retryCount"
  }

  interface Task {
    fields: [id: string, data: any, priority: number]
    constraint: "id required; priority is number"
  }

  -- Agent declarations
  agent QueueBuilder {
    role: IMPLEMENT
    persona: Builder
    scope: ["src/queue.js"]
    implements: TaskQueue
    effect: WRITE_FILE
    gas: 800
    schema_variant: "full"
    outputs: {
      file: "src/queue.js"
      exports: "TaskQueue class"
      algorithm: "binary max-heap with sequence counter for stable FIFO"
    }
  }

  agent WorkerBuilder {
    role: IMPLEMENT
    persona: Builder
    scope: ["src/worker.js"]
    implements: Worker
    effect: WRITE_FILE
    gas: 900
    schema_variant: "full"
    depends_on: [QueueBuilder]
    inputs: {
      queue_interface: TaskQueue
    }
    outputs: {
      file: "src/worker.js"
      exports: "Worker class"
      pattern: "polling loop with in-flight set and WeakMap retry tracking"
    }
  }

  agent TestBuilder {
    role: VERIFY
    persona: Sentinel
    scope: ["src/index.js", "tests/queue.test.js", "tests/worker.test.js"]
    effect: [WRITE_FILE, EXECUTE]
    gas: 700
    schema_variant: "proof"
    depends_on: [QueueBuilder, WorkerBuilder]
    inputs: {
      queue_interface: TaskQueue
      worker_interface: Worker
    }
    outputs: {
      index: "re-exports TaskQueue and Worker"
      queue_tests: "enqueue, dequeue, peek, size, priority, FIFO tie-break, empty edge cases"
      worker_tests: "constructor, start, stop, events, concurrency, retry, no auto-start"
    }
    constraint: TestMustPass {
      rule: "node tests/queue.test.js && node tests/worker.test.js must exit 0"
      recovery: "Report failure, halt, emit TEST_FAILURE signal"
    }
  }

  agent SwarmSteward {
    role: OVERSEE
    persona: Steward
    scope: [".hlf/checkpoints/", "swarm-trace.json"]
    effect: [READ, WRITE_FILE]
    gas: 600
    schema_variant: "summary"
    depends_on: [QueueBuilder, WorkerBuilder, TestBuilder]
    outputs: {
      checkpoints: "per-agent checkpoint snapshots"
      trace: "full swarm execution trace in swarm-trace.json"
      audit: "governance audit log with gas accounting"
    }
    constraint: StewardOversight {
      rule: "All agents must complete within gas budget; checkpoints must be verifiable"
      recovery: "Halt swarm, emit GOVERNANCE_BREACH signal"
    }
  }

  -- No PLAN.md needed — interfaces ARE the plan
  -- No "notes for other agents" — declarations are SSOT

  effect LogFileChanges {
    trigger: WRITE_FILE
    action: append_to_log
    format: "[timestamp] AGENT:agent_name FILE:path CHECKSUM:sha256"
  }

  effect ValidateExports {
    trigger: WRITE_FILE
    action: verify_exports
    rule: "File must export classes matching interface declarations"
  }

  trace {
    level: FULL
    output: "swarm-trace.json"
    fields: [agent_name, persona, interface, file_path, gas_used, checksum]
  }

  checkpoint {
    frequency: PER_AGENT
    storage: "./.hlf/checkpoints/"
  }
}
