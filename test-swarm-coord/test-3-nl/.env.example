NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://chat_user:chat_pass@localhost:5432/chat_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_db
DB_USER=chat_user
DB_PASSWORD=chat_pass

# Test Database
TEST_DATABASE_URL=postgresql://chat_user:chat_pass@localhost:5432/chat_db_test
TEST_DB_NAME=chat_db_test

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me

# CORS
CORS_ORIGIN=*

# Redis
REDIS_URL=redis://localhost:6379

# File Storage
FILE_STORAGE_PATH=./uploads
