# =============================================================================
# SwarmGlass Configuration
# Generated by setup_wizard.py or copied from .env.example
# =============================================================================
# All values shown are defaults. Uncomment and set as needed.
# Critical: MASTER_KEY and SESSION_SECRET must be set for production use.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# TRANSPORT — How SwarmGlass binds to the network
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_TRANSPORT=stdio
#SWARMGLASS_HOST=0.0.0.0
#SWARMGLASS_PORT=8123

# ─────────────────────────────────────────────────────────────────────────────
# AUTH & SECRETS — Encryption, signing, and API auth
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#SWARMGLASS_MASTER_KEY=
#SWARMGLASS_SESSION_SECRET=
#SWARMGLASS_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# MODEL PROVIDERS — API keys for cloud model access
# ─────────────────────────────────────────────────────────────────────────────
#OLLAMA_API_KEY=
#OPENROUTER_API_KEY=
#ZAI_API_KEY=
#JULES_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OLLAMA — Local model server configuration
# ─────────────────────────────────────────────────────────────────────────────
#OLLAMA_HOST=http://localhost:11434
#OLLAMA_HOST_SECONDARY=http://localhost:11435
#OLLAMA_API_KEY_SECONDARY=
#OLLAMA_LOAD_STRATEGY=failover
#OLLAMA_NOAGENT=1

# ─────────────────────────────────────────────────────────────────────────────
# MODEL SELECTION — Default models for each capability lane
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_DEFAULT_MODEL=kimi-k2.6:cloud
#SWARMGLASS_FALLBACK_MODEL=deepseek-v4-pro:cloud
#PRIMARY_MODEL=
#REASONING_MODEL=
#SUMMARIZATION_MODEL=
#EMBEDDING_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE PATHS — Database and log locations
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_STATE_DIR=state
#SWARMGLASS_MEMORY_DB=db/hlf_memory.db
#SWARMGLASS_AUDIT_DB=db/hlf_audit.db
#SWARMGLASS_AUDIT_CHAIN_LOG=logs/audit.jsonl
#SWARMGLASS_AUDIT_CHAIN_LAST_HASH=logs/last_hash.txt
#SWARMGLASS_APPROVAL_LEDGER_DB=db/hlf_capsule_approvals.sqlite3

# ─────────────────────────────────────────────────────────────────────────────
# AGENT & TIER — Capability boundaries
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_AGENT_TIER=sovereign
#SWARMGLASS_AGENT_ID=swarmglass-agent
#SWARMGLASS_CAPABILITIES=read,write,analyze

# ─────────────────────────────────────────────────────────────────────────────
# RAG & VECTOR STORE — ChromaDB connection
# ─────────────────────────────────────────────────────────────────────────────
#CHROMA_HOST=localhost
#CHROMA_PORT=8000

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_EXPERIMENTAL=0
#SWARMGLASS_STRICT=1

# ─────────────────────────────────────────────────────────────────────────────
# EXTERNAL COMPARATORS — HKS semantic comparison service
# ─────────────────────────────────────────────────────────────────────────────
#SWARMGLASS_ENABLE_HKS_EXTERNAL_COMPARATOR=
#SWARMGLASS_HKS_EXTERNAL_COMPARATOR_URL=
#SWARMGLASS_HKS_EXTERNAL_COMPARATOR_TIMEOUT=8
#SWARMGLASS_HKS_EXTERNAL_COMPARATOR_AUTH_HEADER=
#SWARMGLASS_HKS_EXTERNAL_COMPARATOR_AUTH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OVERWATCH — Container daemon configuration
# ─────────────────────────────────────────────────────────────────────────────
#OVERWATCH_SCAN_INTERVAL=30
#OVERWATCH_AUTO_RECOVER=1
#OVERWATCH_MAX_RESTARTS=3

# ─────────────────────────────────────────────────────────────────────────────
# DEPRECATED HLF_* names (still supported via env_migration.py)
# ─────────────────────────────────────────────────────────────────────────────
#HLF_TRANSPORT=stdio
#HLF_PORT=8123
#HLF_MASTER_KEY=
#HLF_API_TOKEN=
#HLF_STRICT=1
