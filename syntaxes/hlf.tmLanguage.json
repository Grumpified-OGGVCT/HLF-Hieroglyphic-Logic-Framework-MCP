{
  "name": "HLF",
  "scopeName": "source.hlf",
  "fileTypes": [
    "hlf"
  ],
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#version_header"
    },
    {
      "include": "#block"
    },
    {
      "include": "#terminator"
    },
    {
      "include": "#line_glyph"
    },
    {
      "include": "#glyph"
    },
    {
      "include": "#ascii_alias"
    },
    {
      "include": "#canonical_tag"
    },
    {
      "include": "#i18n_cjk_tag"
    },
    {
      "include": "#i18n_arabic_tag"
    },
    {
      "include": "#generic_tag"
    },
    {
      "include": "#string"
    },
    {
      "include": "#variable"
    },
    {
      "include": "#control_keyword"
    },
    {
      "include": "#definition_keyword"
    },
    {
      "include": "#declaration_keyword"
    },
    {
      "include": "#spec_keyword"
    },
    {
      "include": "#builtin_keyword"
    },
    {
      "include": "#logical_keyword"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#typed_param"
    },
    {
      "include": "#property_key"
    },
    {
      "include": "#path"
    },
    {
      "include": "#number"
    },
    {
      "include": "#comparison_operator"
    },
    {
      "include": "#arithmetic_operator"
    },
    {
      "include": "#assignment_operator"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.hlf"
    },
    "version_header": {
      "match": "\\[HLF-v\\d+(?:\\.\\d+)*\\]",
      "name": "keyword.control.version.hlf"
    },
    "block": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.block.begin.hlf"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.block.end.hlf"
        }
      },
      "name": "meta.block.hlf",
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "terminator": {
      "match": "Ω|\\b(?:Omega|OMEGA|END)\\b",
      "name": "keyword.operator.terminator.hlf"
    },
    "line_glyph": {
      "match": "^\\s*(?:Δ|Σ|Ж|∇|⊎|⌂|⌘|⨝|⩕)",
      "name": "keyword.control.command.hlf"
    },
    "glyph": {
      "match": "(?:Δ|Σ|Ж|∇|⊎|⌂|⌘|⨝|⩕)",
      "name": "keyword.operator.glyph.hlf"
    },
    "ascii_alias": {
      "match": "\\b(?:MEMORY_ANCHOR|AGGREGATE|CONSENSUS|CONSTRAIN|SUMMARIZE|ANALIZAR|ANALYSER|PRIORITY|ANALYSE|ANALYZE|COMMAND|ENFORCE|SUMMARY|BRANCH|SOURCE|OMEGA|UNION|JOIN|VOTE|CMD|END)\\b",
      "name": "support.constant.alias.hlf"
    },
    "canonical_tag": {
      "match": "\\[(?:RESULTAT_ATTENDU|CONSTRENIMIENTO|EINSCHRAENKUNG|EVIDENCE_CHAIN|MIGRATION_SPEC|BESCHRAENKUNG|CONFIGURACION|CONFIGURATION|DRINGLICHKEIT|KONFIGURATION|CONFIGURACAO|ENRUTAMIENTO|PRECONDICION|PRECONDITION|SOURCE_CHAIN|VERIFICACION|VERIFICATION|VORBEDINGUNG|WEITERLEITEN|WIEDERFINDEN|ZURUECKRUFEN|DATA_SOURCE|DATENQUELLE|GEDAECHTNIS|IMPORTANCIA|OBSERVATION|OUTPUT_TYPE|PRECONDICAO|RESTRICCION|RESTRICTION|SE_SOUVENIR|SOURCE_CODE|SPEC_DEFINE|SPEC_UPDATE|TIPO_SALIDA|TRANSMETTRE|VERIFICACAO|WICHTIGKEIT|AFIRMACION|AUSGABETYP|BEHAUPTUNG|CONSTRAINT|CONTRAINTE|DEFINITION|DELEGACION|DELEGATION|DELEGIEREN|DISTRIBUER|ENCAMINHAR|GOVERNANCE|IMPORTANCE|INTERROGER|LIMITACION|MEMORIEREN|PRIORIDADE|PRIORITAET|PROVENANCE|ROTEAMENTO|TIPO_SAIDA|TRANSFERER|UEBERGEBEN|ABSTIMMEN|ACHEMINER|AFIRMACAO|ALMACENAR|ARGUMENTO|ARMAZENAR|ASIGNAR_A|ASSERTION|ASSIGN_TO|BEDINGUNG|CONSENSUS|CONSTRAIN|CONSULTAR|DELEGACAO|DESPACHAR|INTENCION|INTENTION|LIMITACAO|MEMORISER|MEMORIZAR|MIGRATION|NAMESPACE|PARAMETER|PARAMETRE|PARAMETRO|PRIORIDAD|RATIONALE|REASONING|RECUPERAR|RECUPERER|RESPUESTA|RESTRICAO|RESULTADO|RETOURNER|RUECKGABE|SPEC_GATE|SPEC_SEAL|SPEICHERN|VERTEILEN|ABFRAGEN|AFFIRMER|ARGUMENT|ATRIBUIR|ATTENDRE|BOUNDARY|CHERCHER|CONDICAO|CONSENSO|DELEGATE|DELEGUER|DISPATCH|EINIGUNG|ERGEBNIS|ERINNERN|ERWARTEN|ERWARTET|ESPERADO|EVIDENCE|EXPECTED|FUNCTION|INTENCAO|MEMORIZE|OBJECTIF|OBJETIVO|OBSERVED|PRIORITE|PRIORITY|RAPPELER|RECORDAR|RELATION|REMEMBER|RESPONSE|RESPOSTA|RESTRICT|RESULTAT|RETORNAR|RETRIEVE|URGENCIA|VORHABEN|ZUWEISEN|ABRUFEN|ABSICHT|ACUERDO|ANTWORT|ATTENDU|AUSGABE|CAPSULE|CONFIER|CONTROL|DATASET|DELEGAR|EINGABE|ENRUTAR|ENTRADA|ESPERAR|EXECUTE|FORWARD|GEWICHT|HANDOFF|KONSENS|LEMBRAR|LINEAGE|MEMOIRE|MEMORIA|OBSERVE|OBTENER|PACKAGE|PAYLOAD|PROGRAM|PRUEFEN|REPONSE|RESPOND|ROADMAP|ROUTAGE|ROUTINE|ROUTING|STOCKER|THOUGHT|URGENCE|URGENCY|ACCORD|ACORDO|ACTION|ASSERT|BUSCAR|CONFIG|DEFINE|ENTREE|EXPECT|FUENTE|IMPORT|INTENT|INVOKE|LIMITE|LOOKUP|MEMORY|MODULE|ORIGEM|ORIGEN|OUTPUT|POLICY|QUELLE|QUORUM|RECALL|RELATE|RESULT|RETURN|ROTEAR|ROUTEN|SALIDA|SORTIE|SOURCE|SUCHEN|WEIGHT|AGREE|ALIGN|CATCH|CHECK|DESDE|FONTE|INPUT|MACRO|PARAM|POIDS|QUERY|RANGO|ROUTE|SAIDA|SCOPE|STEPS|STORE|VOTAR|VOTER|WHILE|YIELD|CALL|CODE|DATA|EDGE|FROM|GATE|GOAL|LINK|META|PESO|PLAN|RANG|RANK|SPEC|VOTE|ZIEL|ACT|ARG|BUT|RUN|SET|TRY|VON|DE|FN)\\]",
      "name": "entity.name.tag.hlf"
    },
    "generic_tag": {
      "match": "\\[[A-Z][A-Z0-9_]*\\]",
      "name": "entity.name.tag.unregistered.hlf"
    },
    "string": {
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.hlf"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.hlf"
        }
      },
      "name": "string.quoted.double.hlf",
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#string_variable"
        }
      ]
    },
    "escape": {
      "match": "\\\\.",
      "name": "constant.character.escape.hlf"
    },
    "string_variable": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}",
      "name": "variable.other.interpolated.hlf"
    },
    "variable": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*|\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}",
      "name": "variable.other.hlf"
    },
    "control_keyword": {
      "match": "\\b(?:IF|ELIF|ELSE|ENDIF|FOR|IN|PARALLEL)\\b",
      "name": "keyword.control.flow.hlf"
    },
    "definition_keyword": {
      "match": "\\b(?:FUNCTION|INTENT)\\b",
      "name": "keyword.control.definition.hlf"
    },
    "declaration_keyword": {
      "match": "\\b(?:SET|ASSIGN)\\b",
      "name": "storage.type.hlf"
    },
    "spec_keyword": {
      "match": "\\b(?:SPEC_DEFINE|SPEC_GATE|SPEC_UPDATE|SPEC_SEAL)\\b",
      "name": "keyword.other.spec.hlf"
    },
    "builtin_keyword": {
      "match": "\\b(?:CALL|TOOL|IMPORT|LOG|RETURN|MEMORY|RECALL|RESULT|ROUTE|DELEGATE)\\b",
      "name": "support.function.hlf"
    },
    "logical_keyword": {
      "match": "\\b(?:AND|OR|NOT)\\b",
      "name": "keyword.operator.logical.hlf"
    },
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.hlf"
    },
    "typed_param": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(:)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {
          "name": "variable.parameter.hlf"
        },
        "2": {
          "name": "punctuation.separator.type.hlf"
        },
        "3": {
          "name": "support.type.hlf"
        }
      }
    },
    "property_key": {
      "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*=)",
      "name": "variable.parameter.key.hlf"
    },
    "path": {
      "match": "(?:(?<=\\s)|^)/(?:[^\\s\\[\\]#{}()]|\\ )+",
      "name": "string.unquoted.path.hlf"
    },
    "number": {
      "match": "\\b\\d+(?:\\.\\d+)?\\b",
      "name": "constant.numeric.hlf"
    },
    "comparison_operator": {
      "match": "==|!=|<=|>=|<|>",
      "name": "keyword.operator.comparison.hlf"
    },
    "arithmetic_operator": {
      "match": "[-+*/%]",
      "name": "keyword.operator.arithmetic.hlf"
    },
    "assignment_operator": {
      "match": "=",
      "name": "keyword.operator.assignment.hlf"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\(",
          "name": "punctuation.section.parens.begin.hlf"
        },
        {
          "match": "\\)",
          "name": "punctuation.section.parens.end.hlf"
        }
      ]
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.readwrite.hlf"
    },
    "i18n_cjk_tag": {
      "match": "\\[(?:アサーション|コンセンサス|ディスパッチ|データソース|ルーティング|デリゲート|パラメータ|レスポンス|制約条件|前提条件|前置条件|呼び出す|引き渡し|法定人数|约束条件|記憶する|クエリ|ソース|メモリ|ルート|优先级|優先度|定足数|数据源|期待値|紧急度|緊急度|记忆化|配置项|重要性|から|予期|代理|入力|共识|出力|分发|制約|制限|参数|取得|召回|合意|同意|响应|委任|委托|委派|委譲|存储|引数|想起|意図|意图|投票|断言|期待|期望|权重|来源|查找|查询|检查|检索|検索|目标|目標|目的|確認|結果|约束|结果|記憶|記録|設定|记住|记忆|调度|路由|転送|转交|转发|输入|输出|返却|返回|配置|重み|限制|预期|从)\\]",
      "name": "entity.name.tag.i18n.hlf"
    },
    "i18n_arabic_tag": {
      "match": "\\[(?:بيانات_مصدر|نوع_الإخراج|تفويض_مهمة|شرط\\ مسبق|استجابة|استذكار|استرجاع|استعلام|أولوية|موافقة|أهمية|إخراج|إدخال|إرجاع|إرسال|إسناد|إلحاح|تأكيد|تخزين|تصويت|تفويض|تقييد|تمرير|تهيئة|توافق|توجيه|ذاكرة|متوقع|معامل|نتيجة|وسيطة|تذكر|توقع|غاية|قيود|مصدر|نصاب|بحث|حفظ|فحص|قيد|نية|هدف|وزن)\\]",
      "name": "entity.name.tag.i18n.hlf"
    }
  }
}
